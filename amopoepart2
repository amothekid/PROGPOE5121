            int sentCount = 0;

            // --- Setup Gson and JSON file ---
            Gson gson = new GsonBuilder().setPrettyPrinting().create();
            File messageFile = new File("messages.json");
            List<MessageSystem> messages = new ArrayList<>();

            if (messageFile.exists()) {
                try (Reader reader = new FileReader(messageFile)) {
                    messages = gson.fromJson(reader, new TypeToken<List<MessageSystem>>(){}.getType());
                    if (messages == null) messages = new ArrayList<>();
                } catch (IOException e) {
                    System.out.println("Error reading messages: " + e.getMessage());
                }
            }

            int option;
            do {
                System.out.println("\nPlease choose an option:");
