                System.out.println("3) Quit");
                System.out.print("Enter choice: ");
                option = scan.nextInt();
                scan.nextLine();

                switch (option) {
                    case 1:
                        if (sentCount < totalMessages) {
                            System.out.print("Enter recipient number: ");
                            String recipient = scan.nextLine();

                            System.out.print("Enter message text (max 250 chars): ");
